# Copy to .env.local and fill in real values. .env.local is gitignored.

# --- Supabase ---
# Project ref: rbawvdphywypzufnpaos (us-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://rbawvdphywypzufnpaos.supabase.co
# Publishable / anon key - safe to expose to the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App ---
# Used to build Stripe Checkout success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=
